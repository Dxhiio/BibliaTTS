  "verse_map": [
    {
      "verse": 1,
      "label": "1",
      "char_start": 0,
      "char_end": 92,
      "text": "¡Alabemos a nuestro Dios! ¡Alabemos a Dios en su santuario! ¡Alabemos su poder en el cielo!"
    },
    {
      "verse": 2,
      "label": "2",
      "char_start": 92,
      "char_end": 160,
      "text": "¡Alabemos sus grandes acciones! ¡Alabemos su incomparable grandeza!"
    },
    {
      "verse": 3,
      "label": "3",
      "char_start": 160,
      "char_end": 227,
      "text": "¡Alabémoslo con sonido de trompeta! ¡Alabémoslo con arpas y liras!"
    },
    {
      "verse": 4,
      "label": "4",
      "char_start": 227,
      "char_end": 297,
      "text": "¡Alabémoslo con panderos y danzas! ¡Alabémoslo con cuerdas y flautas!"
    },
    {
      "verse": 5,
      "label": "5",
      "char_start": 297,
      "char_end": 369,
      "text": "¡Alabémoslo con sonoros platillos! ¡Alabémoslo con platillos vibrantes!"
    },
    {
      "verse": 6,
      "label": "6",
      "char_start": 369,
      "char_end": 437,
      "text": "¡Que alaben a Dios todos los seres vivos! ¡Alabemos a nuestro Dios!"
    }
  ],
